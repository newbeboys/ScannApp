# =========================================
# ENVIRONMENT VARIABLES — Scanner App
# Salin file ini jadi `.env` dan isi nilai asli.
# JANGAN commit file `.env` (isi asli) ke git.
# =========================================

# --- Supabase (Project BARU khusus Scanner App — BUKAN project FinanceApp) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Cloudflare R2 (HANYA untuk Edge Function / server-side, JANGAN pernah expose ke client) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# --- App Config (angka final — lihat PRD v2 Bagian 7) ---
VITE_APP_TIER_BASIC_STORAGE_QUOTA_MB=100
VITE_APP_TIER_PRO_MONTHLY_STORAGE_QUOTA_MB=500
VITE_APP_TIER_PRO_YEARLY_STORAGE_QUOTA_MB=1000
VITE_APP_TIER_PRO_REFERRAL_STORAGE_QUOTA_MB=500   # Pro dari hadiah referral: sama dengan Pro bulanan
VITE_APP_BASIC_MAX_MERGE_PAGES=20            # limit halaman merge dokumen untuk Basic; Pro unlimited (null/tidak dicek)

# --- Ads (Basic tier) ---
# ID unit iklan yang dipakai client WAJIB berprefiks VITE_ supaya ikut ter-bundle.
# Kalau dua baris VITE_ di bawah dikosongkan, aplikasi jatuh ke ID test resmi Google —
# aman dipakai sebelum akun AdMob ada. Build DEV selalu pakai ID test apa pun isinya.
VITE_ADMOB_BANNER_UNIT_ID=
VITE_ADMOB_INTERSTITIAL_UNIT_ID=

ADMOB_APP_ID=
ADMOB_BANNER_UNIT_ID=
ADMOB_INTERSTITIAL_UNIT_ID=
ADS_INTERSTITIAL_FREQUENCY=every_5_scans_plus_after_export

# --- Referral (milestone final — lihat PRD v2 Bagian 5, dikonfigurasi juga di tabel referral_milestones) ---
REFERRAL_MILESTONE_1_COUNT=5
REFERRAL_MILESTONE_1_PRO_DAYS=7
REFERRAL_MILESTONE_2_COUNT=15
REFERRAL_MILESTONE_2_PRO_DAYS=25
REFERRAL_MILESTONE_3_COUNT=30
REFERRAL_MILESTONE_3_PRO_DAYS=60
REFERRAL_REFERRED_USER_BONUS_DAYS=1

# --- Pricing Pro (referensi tampilan harga di UI, transaksi aktual lewat in-app purchase) ---
PRICING_PRO_MONTHLY_IDR=15000
PRICING_PRO_YEARLY_IDR=150000

# --- Scheduled Job ---
EXPIRE_PRO_STATUS_JOB_INTERVAL=daily          # job expire-pro-status jalan tiap hari (00:00)
