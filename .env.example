# =========================================
# ENVIRONMENT VARIABLES — Scanner App
# Salin file ini jadi `.env` dan isi nilai asli.
# JANGAN commit file `.env` (isi asli) ke git.
# =========================================

# --- Supabase (Project BARU khusus Scanner App — BUKAN project FinanceApp) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Cloudflare R2 (HANYA untuk Edge Function / server-side, JANGAN pernah expose ke client) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# --- App Config (angka final — lihat PRD v2 Bagian 7) ---
VITE_APP_TIER_BASIC_STORAGE_QUOTA_MB=100
VITE_APP_TIER_PRO_MONTHLY_STORAGE_QUOTA_MB=500
VITE_APP_TIER_PRO_YEARLY_STORAGE_QUOTA_MB=1000
VITE_APP_TIER_PRO_REFERRAL_STORAGE_QUOTA_MB=500   # Pro dari hadiah referral: sama dengan Pro bulanan
VITE_APP_BASIC_MAX_MERGE_PAGES=20            # limit halaman merge dokumen untuk Basic; Pro unlimited (null/tidak dicek)

# --- Ads (Basic tier) ---
# ID unit iklan yang dipakai client WAJIB berprefiks VITE_ supaya ikut ter-bundle.
# Kalau salah satu dari tiga baris VITE_ di bawah kosong, aplikasi jatuh ke ID test
# resmi Google untuk KETIGANYA — sengaja semua-atau-tidak-sama-sekali, supaya tidak
# ada kondisi setengah jadi yang menyajikan iklan asli di satu slot dan iklan test di
# slot lain. Build DEV selalu pakai ID test apa pun isinya: impresi berulang dari HP
# developer sendiri itu invalid traffic, dan AdMob menutup akun karenanya.
VITE_ADMOB_BANNER_UNIT_ID=
VITE_ADMOB_INTERSTITIAL_UNIT_ID=
VITE_ADMOB_APP_OPEN_UNIT_ID=

# App ID ditulis di android/app/src/main/AndroidManifest.xml, bukan dibaca dari sini —
# baris ini cuma catatan supaya nilainya ada di satu tempat bersama yang lain.
ADMOB_APP_ID=
ADMOB_BANNER_UNIT_ID=
ADMOB_INTERSTITIAL_UNIT_ID=
ADMOB_APP_OPEN_UNIT_ID=

# Kebijakan iklan final (CLAUDE.md Bagian 6, keputusan Boss Ali 23 Agustus 2026):
# interstitial setelah selesai edit, setelah selesai merge, dan setelah 7 scan
# berurutan dalam kurang dari 10 menit. App Open ad saat aplikasi dibuka dan saat
# user kembali setelah pergi lebih dari 5 detik.
ADS_INTERSTITIAL_FREQUENCY=after_edit_merge_and_7_scan_streak
ADS_APP_OPEN_RESUME_AFTER_SECONDS=5


# --- RevenueCat (jembatan ke Google Play Billing) ---
# Public SDK key Android. Memang dirancang untuk ada di client (bukan secret),
# tapi tetap lewat env var — tidak ada credential yang di-hardcode (Aturan Keras #1).
# Kalau kosong, layar Upgrade tampil dengan pesan "pembelian belum aktif" alih-alih crash.
VITE_REVENUECAT_ANDROID_KEY=

# Identifier yang HARUS sama persis dengan dashboard RevenueCat & Play Console.
VITE_REVENUECAT_ENTITLEMENT_ID=pro
VITE_REVENUECAT_PRODUCT_MONTHLY=scannapp_pro_monthly
VITE_REVENUECAT_PRODUCT_YEARLY=scannapp_pro_yearly

# HANYA untuk Supabase Edge Function Secrets — JANGAN taruh di client, jangan
# beri prefiks VITE_. Ini SIGNING SECRET dari toggle "HMAC webhook signing"
# di dashboard RevenueCat (Integrations > Webhooks > integrasi ini),
# BUKAN nilai Authorization header — Edge Function memverifikasi header
# X-RevenueCat-Webhook-Signature (HMAC-SHA256), tidak membandingkan bearer
# statis. Nilainya hanya ditampilkan sekali saat dibuat/di-rotate di
# dashboard RevenueCat; salin ke Supabase > Edge Functions > Secrets dengan
# nama persis di bawah.
# Kalau belum diset, Edge Function menolak semua request dengan 503 —
# sengaja, supaya endpoint-nya tidak jadi jalan bagi siapa pun untuk
# memberi dirinya Pro.
# REVENUECAT_WEBHOOK_SECRET=

# HANYA untuk Supabase Edge Function Secrets — JANGAN beri prefiks VITE_.
# Ini SECRET API KEY v1 RevenueCat (dashboard > Project settings > API keys >
# "Secret API keys"), BUKAN public SDK key di atas dan BUKAN signing secret
# webhook. Dipakai request-account-deletion untuk menanyakan
# GET /v1/subscribers/{app_user_id} — apakah langganan Play Store user masih
# jalan sebelum akunnya boleh dijadwalkan hapus.
# Kalau belum diset, fungsi tidak menolak semuanya: ia jatuh ke pengecekan
# profiles.tier/pro_plan dan mencatat peringatan di log. Alasannya, Google
# Play mewajibkan jalur hapus akun tersedia — mematikannya total hanya karena
# satu pihak ketiga tidak bisa dihubungi justru melanggar syarat itu.
# REVENUECAT_SECRET_API_KEY=

# Entitlement id yang dibaca Edge Function (sisi server). Harus sama dengan
# VITE_REVENUECAT_ENTITLEMENT_ID di atas; defaultnya 'pro' kalau tidak diset.
# REVENUECAT_ENTITLEMENT_ID=pro

# --- Referral (milestone final — lihat PRD v2 Bagian 5, dikonfigurasi juga di tabel referral_milestones) ---
REFERRAL_MILESTONE_1_COUNT=5
REFERRAL_MILESTONE_1_PRO_DAYS=7
REFERRAL_MILESTONE_2_COUNT=15
REFERRAL_MILESTONE_2_PRO_DAYS=25
REFERRAL_MILESTONE_3_COUNT=30
REFERRAL_MILESTONE_3_PRO_DAYS=60
REFERRAL_REFERRED_USER_BONUS_DAYS=1

# --- Pricing Pro (referensi tampilan harga di UI, transaksi aktual lewat in-app purchase) ---
PRICING_PRO_MONTHLY_IDR=15000
PRICING_PRO_YEARLY_IDR=150000

# --- Scheduled Job ---
EXPIRE_PRO_STATUS_JOB_INTERVAL=daily          # job expire-pro-status jalan tiap hari (00:00)

# --- Hapus Akun (Fase 8.5a) ---
# Masa tunggu sebelum akun benar-benar dihapus permanen. Angka final
# CLAUDE.md Bagian 6 — dipakai sebagai konstanta GRACE_PERIOD_DAYS di
# supabase/functions/_shared/accountDeletion.ts dan src/lib/accountDeletion.ts,
# bukan dibaca dari env saat runtime. Baris ini dokumentasi, bukan sakelar.
ACCOUNT_DELETION_GRACE_PERIOD_DAYS=7
ACCOUNT_DELETION_JOB_INTERVAL=daily           # job process-account-deletions jalan tiap hari (04:00)
