<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTop"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

        </activity>

        <!--
            AdMob APPLICATION_ID. SDK Google Mobile Ads sengaja membuat aplikasi
            crash saat start kalau meta-data ini tidak ada, jadi nilainya tidak
            boleh kosong.

            Ini App ID asli akun AdMob Boss Ali (dipasang 23 Agustus 2026).
            App ID bukan rahasia — memang wajib tertulis di manifest yang ikut
            terkirim di dalam APK, jadi tidak melanggar Aturan Keras #1.

            Yang menentukan iklan asli atau iklan test adalah UNIT ID, bukan
            baris ini: resolveAdConfig() selalu jatuh ke unit test kalau
            VITE_ADMOB_*_UNIT_ID kosong atau build-nya build dev.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1798871739591323~7781334359" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Google Play Billing — required for the Pro subscription (monthly / yearly).
        The Play Billing Library already merges this permission in automatically;
        it is declared here explicitly so the app's billing usage is self-documenting.
    -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!--
        Dipakai HANYA oleh tujuan ekspor "Simpan ke HP", yang menulis ke
        folder Documents publik supaya file-nya bisa ditemukan lewat file
        manager. Tujuan "Bagikan" tidak menyentuh folder publik sama sekali —
        ia menulis ke cache privat aplikasi lalu menyerahkannya lewat
        FileProvider, supaya membatalkan share sheet tidak meninggalkan
        berkas apa pun (keputusan Boss Ali 27 Agustus 2026).

        Izin ini hanya diperlukan di Android 10 ke bawah; Android 11+
        (scoped storage) tidak memintanya.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
</manifest>
